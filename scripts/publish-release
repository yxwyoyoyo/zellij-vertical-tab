#!/bin/sh
set -eu

usage() {
    printf 'Usage: mise run publish -- vMAJOR.MINOR.PATCH\n' >&2
    exit 2
}

fail() {
    printf 'Release not published: %s\n' "$1" >&2
    exit 1
}

[ "$#" -eq 1 ] || usage
tag=$1
printf '%s\n' "$tag" | grep -Eq '^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$' || usage

for command_name in git gh mise shasum; do
    command -v "$command_name" >/dev/null 2>&1 ||
        fail "required command is unavailable: $command_name"
done

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_root"

[ -z "$(git status --porcelain)" ] ||
    fail "the worktree must be clean, including untracked files"
gh auth status >/dev/null 2>&1 ||
    fail "GitHub CLI is not authenticated; run 'gh auth login'"

repository=$(gh repo view --json nameWithOwner --jq '.nameWithOwner')
default_branch=$(gh repo view --json defaultBranchRef --jq '.defaultBranchRef.name')
current_branch=$(git branch --show-current)
[ "$current_branch" = "$default_branch" ] ||
    fail "current branch '$current_branch' is not the remote default '$default_branch'"

package_version=$(
    sed -n '/^\[package\]/,/^\[/s/^version = "\([^"]*\)"/\1/p' Cargo.toml |
        head -n 1
)
[ -n "$package_version" ] || fail "could not read the package version from Cargo.toml"
[ "$tag" = "v$package_version" ] ||
    fail "tag '$tag' does not match Cargo.toml version '$package_version'"

zellij_version=$(
    sed -n 's/^zellij-tile = "\([^"]*\)"/\1/p' Cargo.toml |
        head -n 1
)
[ -n "$zellij_version" ] ||
    fail "could not read the zellij-tile version from Cargo.toml"

git fetch --quiet origin "$default_branch" --tags
local_head=$(git rev-parse HEAD)
remote_head=$(git rev-parse "origin/$default_branch")
[ "$local_head" = "$remote_head" ] ||
    fail "local HEAD does not match origin/$default_branch"

if git show-ref --verify --quiet "refs/tags/$tag"; then
    fail "tag '$tag' already exists"
fi
if gh release view "$tag" --repo "$repository" >/dev/null 2>&1; then
    fail "GitHub Release '$tag' already exists"
fi

mise run release

artifact="$repo_root/target/wasm32-wasip1/release/zellij_vertical_tab.wasm"
[ -f "$artifact" ] || fail "release artifact was not produced: $artifact"
[ -s "$artifact" ] || fail "release artifact is empty: $artifact"

stage_dir=$(mktemp -d "${TMPDIR:-/tmp}/zellij-vertical-tab-release.XXXXXX")
trap 'rm -rf "$stage_dir"' EXIT HUP INT TERM
asset="$stage_dir/zellij_vertical_tab.wasm"
checksum="$stage_dir/zellij_vertical_tab.wasm.sha256"
cp "$artifact" "$asset"
(
    cd "$stage_dir"
    shasum -a 256 zellij_vertical_tab.wasm >zellij_vertical_tab.wasm.sha256
)

notes=$(
    printf 'Built for Zellij **%s**. The `zellij-tile` dependency must match your Zellij binary.\n\nVerify the download with `shasum -a 256 -c zellij_vertical_tab.wasm.sha256`.' \
        "$zellij_version"
)

gh release create "$tag" \
    "$asset#Zellij vertical tab WASM" \
    "$checksum#SHA-256 checksum" \
    --repo "$repository" \
    --target "$local_head" \
    --title "$tag" \
    --notes "$notes" \
    --generate-notes \
    --fail-on-no-commits

git fetch --quiet origin "refs/tags/$tag:refs/tags/$tag"
gh release view "$tag" \
    --repo "$repository" \
    --json tagName,name,url,publishedAt,assets
